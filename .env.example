# Host port used by docker compose
APP_PORT=5000

# White-label branding. APP_NAME is the product name shown by the API, the MCP server and (as
# VITE_APP_NAME, which docker compose fills from it) the frontend. APP_SLUG names the docker compose
# containers and the local Postgres user/database.
APP_NAME=Drawdoro
APP_SLUG=drawdoro

# development | test | production
ENV=development
LOG_LEVEL=INFO
# JSON list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://drawdoro:drawdoro@localhost:5432/drawdoro

# Authentication (Cognito). Required in production: the API refuses to start without it.
AUTH_ENABLED=false
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Shared secret for trusted services (the MCP server sends it as X-API-Key)
SERVICE_API_KEY=

# Personal gallery: maximum size, in bytes, of an uploaded image and of a saved selection
GALLERY_MAX_IMAGE_BYTES=2097152
GALLERY_MAX_SHAPES_BYTES=5242880
# Largest canvas, in bytes, a diagram may reach when a gallery item is inserted into it (by the API
# or the MCP server); inserted images are embedded in the canvas
GALLERY_MAX_CANVAS_BYTES=20971520

# Diagram history. A person's saves within REVISION_INTERVAL_MINUTES share one revision; agent
# (MCP) changes and restores always get their own. Revisions older than REVISION_RETENTION_DAYS or
# beyond the newest REVISION_MAX_PER_DIAGRAM are deleted; 0 disables that limit.
REVISION_INTERVAL_MINUTES=10
REVISION_RETENTION_DAYS=30
REVISION_MAX_PER_DIAGRAM=100
