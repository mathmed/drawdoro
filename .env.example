# Host port used by docker compose
APP_PORT=5000

# White-label branding. APP_NAME is the product name shown by the API, the MCP server and (as
# VITE_APP_NAME, which docker compose fills from it) the frontend. APP_SLUG names the docker compose
# containers and the local Postgres user/database.
APP_NAME=Drawdoro
APP_SLUG=drawdoro

# development | test | production
ENV=development
LOG_LEVEL=INFO
# JSON list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://drawdoro:drawdoro@localhost:5432/drawdoro

# Authentication (Cognito). Required in production: the API refuses to start without it.
AUTH_ENABLED=false
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Shared secret for trusted services (the MCP server sends it as X-API-Key)
SERVICE_API_KEY=

# Personal gallery: maximum size, in bytes, of an uploaded image and of a saved selection
GALLERY_MAX_IMAGE_BYTES=2097152
GALLERY_MAX_SHAPES_BYTES=5242880
