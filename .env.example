# Host port used by docker compose
APP_PORT=5000

# development | test | production
ENV=development
LOG_LEVEL=INFO
# JSON list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://drawdoro:drawdoro@localhost:5432/drawdoro

# Authentication (Cognito). Required in production: the API refuses to start without it.
AUTH_ENABLED=false
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Shared secret for trusted services (the MCP server sends it as X-API-Key)
SERVICE_API_KEY=
