# Cognito managed login. Leave the domain or client id empty to disable login (local dev).
# Domain of the user pool's managed login, e.g. https://<prefix>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
# Public app client (no secret) of the same pool the API validates against
VITE_COGNITO_CLIENT_ID=
# Identity provider name configured in the pool; sends users straight to Google
VITE_COGNITO_IDENTITY_PROVIDER=Google

# White-label branding. Product name shown in the UI and the page title (default: Drawdoro).
VITE_APP_NAME=
# Prefix of the browser storage keys (session, theme, last workspace). Defaults to the slug of
# VITE_APP_NAME; changing it signs everyone out, so set it once and keep it.
VITE_APP_SLUG=

# MCP server endpoint shown in the "Connect Claude" guide (default: http://localhost:8001/mcp).
VITE_MCP_URL=
